 <style:style style:name="c0" style:family="table-column"><style:table-column-properties style:column-width="2.2cm"/></style:style><style:style style:name="c1" style:family="table-column"><style:table-column-properties style:column-width="7.5cm"/></style:style><style:style style:name="c2" style:family="table-column"><style:table-column-properties style:column-width="3.4cm"/></style:style><style:style style:name="c3" style:family="table-column"><style:table-column-properties style:column-width="6cm"/></style:style><style:style style:name="c4" style:family="table-column"><style:table-column-properties style:column-width="2.6cm"/></style:style><style:style style:name="c5" style:family="table-column"><style:table-column-properties style:column-width="4.4cm"/></style:style><style:style style:name="c6" style:family="table-column"><style:table-column-properties style:column-width="15cm"/></style:style><style:style style:name="c7" style:family="table-column"><style:table-column-properties style:column-width="7cm"/></style:style>
 <style:style style:name="Gras" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
 <style:style style:name="Entete" style:family="table-cell">
  <style:table-cell-properties fo:background-color="#6d28d9" fo:padding="0.15cm" style:vertical-align="middle" fo:border="0.02cm solid #4c1d95"/>
  <style:text-properties fo:font-weight="bold" fo:color="#ffffff" fo:font-size="11pt"/>
 </style:style>
 <style:style style:name="Titre" style:family="table-cell">
  <style:table-cell-properties fo:background-color="#ede9fe" fo:padding="0.12cm" style:vertical-align="middle" fo:border="0.02cm solid #c4b5fd"/>
  <style:text-properties fo:font-weight="bold" fo:color="#4c1d95" fo:font-size="11pt"/>
 </style:style>
 <style:style style:name="Corps" style:family="table-cell">
  <style:table-cell-properties fo:wrap-option="wrap" style:vertical-align="top" fo:padding="0.1cm" fo:border="0.02cm solid #e4e4e7"/>
  <style:text-properties fo:font-size="10pt"/>
 </style:style>
 <style:style style:name="Case" style:family="table-cell">
  <style:table-cell-properties fo:background-color="#fffbeb" fo:padding="0.1cm" style:vertical-align="middle" fo:border="0.06cm solid #a16207"/>
  <style:text-properties fo:font-size="14pt" fo:font-weight="bold" fo:color="#a16207"/>
 </style:style>
 <style:style style:name="Salle" style:family="table-cell">
  <style:table-cell-properties fo:background-color="#fecaca" fo:padding="0.1cm" style:vertical-align="middle" fo:border="0.02cm solid #b91c1c"/>
  <style:text-properties fo:font-size="10pt" fo:font-weight="bold" fo:color="#7f1d1d"/>
 </style:style>
 <style:style style:name="Leger" style:family="table-cell">
  <style:table-cell-properties fo:background-color="#fed7aa" fo:padding="0.1cm" style:vertical-align="middle" fo:border="0.02cm solid #c2410c"/>
  <style:text-properties fo:font-size="10pt" fo:color="#7c2d12"/>
 </style:style>
 <style:style style:name="Partout" style:family="table-cell">
  <style:table-cell-properties fo:background-color="#bbf7d0" fo:padding="0.1cm" style:vertical-align="middle" fo:border="0.02cm solid #15803d"/>
  <style:text-properties fo:font-size="10pt" fo:color="#14532d"/>
 </style:style>
</office:automatic-styles>
<office:body><office:spreadsheet>
<table:table table:name="Tournage vidéos"><table:table-column table:style-name="c0"/><table:table-column table:style-name="c1"/><table:table-column table:style-name="c2"/><table:table-column table:style-name="c3"/><table:table-column table:style-name="c4"/><table:table-column table:style-name="c5"/><table:table-column table:style-name="c6"/><table:table-column table:style-name="c7"/>
<table:table-row><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>☐ Faite</text:p></table:table-cell><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>Exercice</text:p></table:table-cell><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>Lieu</text:p></table:table-cell><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>Matériel (option la plus simple)</text:p></table:table-cell><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>Fréq.</text:p></table:table-cell><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>Type</text:p></table:table-cell><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>Consigne d'exécution</text:p></table:table-cell><table:table-cell table:style-name="Entete" office:value-type="string"><text:p>Vigilance au tournage</text:p></table:table-cell></table:table-row>
<table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ PECTORAUX</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>22 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 15 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Écarté poulie</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Station câbles double</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>175</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bras quasi tendus, angle des coudes fixe. Rapproche les mains devant toi et marque un temps au centre.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé couché barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>109</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Omoplates serrées et fixées sur le banc, pieds au sol. Descends la barre au niveau des tétons, coudes à environ 45° du corps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé incliné barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Banc réglable</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>85</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Banc à 30°, pas plus : au-delà, ce sont les épaules qui prennent le travail. Descends la barre haut sur la poitrine.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Écarté incliné haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc réglable</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>57</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bras légèrement fléchis, angle fixe du début à la fin. Ouvre jusqu'à l'étirement, referme sans laisser les haltères se toucher.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé incliné haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc réglable</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>28</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Banc à 30°, descends jusqu'à l'étirement. Ne cogne pas les haltères en haut, garde la tension.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé couché haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>18</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Omoplates serrées, descends jusqu'à l'étirement des pectoraux. L'amplitude est plus grande qu'à la barre, profites-en.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pec deck</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pec deck</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>14</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos calé, coudes à hauteur d'épaules. Referme lentement et marque un temps d'arrêt au centre.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe pieds surélevés</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>13</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pieds sur un banc ou une chaise — plus ils sont hauts, plus le haut des pectoraux travaille.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé couché machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé couché machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Règle le siège pour que les poignées arrivent au niveau du bas des pectoraux. Omoplates serrées contre le dossier, ne décolle pas les épaules pour finir la poussée.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé couché Smith</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Smith machine + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Place le banc pour que la barre descende au niveau des tétons : la barre étant guidée, c'est la position du banc qui détermine tout. Vérifie les crochets avant de lâcher la charge.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé décliné haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc décliné</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Banc incliné vers le bas, pieds bien calés. Descends les haltères vers le bas des pectoraux, coudes rentrés. Fais-toi passer les haltères ou pose-les sur les cuisses avant de t'allonger.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé incliné machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé incliné machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Siège réglé pour que les poignées soient au niveau du haut des pectoraux. Pousse vers le haut et l'avant, sans hausser les épaules.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Écarté haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Coudes légèrement fléchis et VERROUILLÉS dans cet angle : si tu les plies pendant le mouvement, tu fais un développé. Descends jusqu'à sentir l'étirement, pas plus bas.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Écarté poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poulies en position basse, buste légèrement penché en avant. Monte les bras en arc de cercle jusqu'à hauteur des épaules, coudes fixes et à peine fléchis.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Écarté poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poulies en haut, un pas en avant pour mettre les câbles sous tension. Ramène les mains devant le bas de la poitrine en arc de cercle, coudes fixes.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dips lestés aux barres parallèles</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barres parallèles + Ceinture de lest</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>76</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Ceinture de lest, buste penché en avant. Contrôle la descente, pas de rebond en bas.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dips (poitrine)</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barres parallèles</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>15</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché en avant, coudes légèrement écartés. Descends jusqu'à l'étirement des pectoraux sans forcer sur l'épaule.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>55</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Corps gainé et aligné, mains largeur d'épaules. Descends la poitrine près du sol. Avancé : sac à dos chargé sur le haut du dos pour rester dans la plage de répétitions.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dips entre deux chaises (buste penché)</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mains sur deux chaises stables, buste penché en avant pour cibler les pectoraux. Pieds éloignés ou surélevés pour durcir, sac à dos chargé ensuite. Vérifie que les chaises ne peuvent pas glisser.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe large</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe mains nettement plus larges que les épaules : l'amplitude se fait davantage sur les pectoraux. Sac à dos chargé si c'est trop simple.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe large pieds surélevés (chaise)</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe large avec les pieds sur une chaise — plus les pieds sont hauts, plus le haut des pectoraux travaille. Sac à dos chargé ensuite.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe pieds surélevés (chaise)</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe classique avec les pieds sur une chaise. Sac à dos chargé si c'est trop simple.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ DOS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>27 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 14 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Tirage poulie bras tendus</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>242</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bras quasi tendus, angle des coudes fixe du début à la fin. Ramène la barre vers les cuisses par les dorsaux, pas par les triceps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Soulevé de terre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>107</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre contre les tibias, dos plat, épaules au-dessus de la barre. Pousse dans le sol avec les jambes et termine hanches tendues, sans partir en arrière.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>65</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché à environ 45°, dos plat. Tire la barre vers le nombril, coudes le long du corps, sans à-coup des lombaires.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Tirage vertical pronation</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Tirage vertical</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>45</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Prise large, sors la poitrine et tire la barre vers le haut du torse. Remonte sans lâcher la tension.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hyperextension</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>GHD</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bassin calé sur le coussin, hanches libres. Descends en gardant le dos droit et remonte jusqu'à l'alignement du corps — ne pars pas en hyperextension lombaire au sommet.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pullover haltère</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé sur le banc, haltère tenu à deux mains au-dessus de la poitrine. Descends derrière la tête bras quasi tendus jusqu'à l'étirement, sans cambrer le bas du dos.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rack pull</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Rack squat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre calée dans le rack au niveau des genoux ou juste en dessous. Dos plat, tire en poussant le sol. La charge est lourde : la moindre rondeur lombaire se paie.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing assis câble</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing assis machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste droit, genoux à peine fléchis. Tire les coudes vers l'arrière en serrant les omoplates ; ne balance pas le buste pour lancer la charge.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing barre prise supination</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Prise en supination largeur d'épaules, buste penché à 45°, dos plat. Tire vers le nombril, coudes près du corps. Ne va pas à l'échec : c'est le dos qui cède en premier.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing câble unilatéral</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un bras à la fois, buste stable. Laisse l'omoplate s'étirer vers l'avant en fin de retour, puis tire en la ramenant vers la colonne. Ne pivote pas le buste pour aller plus loin.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing horizontal machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing horizontal machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poitrine calée contre le support, épaules basses. Tire les poignées vers les hanches en serrant les omoplates, sans décoller le torse du coussin.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing T-bar</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing T-bar machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché à environ 45°, dos gainé et bien plat. Tire la barre vers le nombril, coudes près du corps ; seuls les bras bougent, le dos reste immobile.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Seal row</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé sur le ventre sur un banc surélevé, bras pendants. Tire la barre vers le banc : le buste ne pouvant pas bouger, aucune triche n'est possible.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Tirage vertical prise supination</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Tirage vertical</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mains en supination largeur d'épaules. Tire la barre vers le haut de la poitrine en sortant le sternum, coudes vers le bas et l'arrière.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Traction pronation</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre de traction</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>228</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Paumes vers l'avant. Monte jusqu'à passer le menton au-dessus de la barre, redescends bras complètement tendus.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing haltère unilatéral</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>47</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un genou et une main sur le banc, dos plat. Tire l'haltère vers la hanche sans tourner le buste.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Traction supination (chin-up)</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre de traction</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>16</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Paumes vers toi, mains largeur d'épaules. Les biceps participent davantage qu'en pronation.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing TRX</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sangles TRX</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>14</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Corps gainé et incliné, bras tendus. Tire la poitrine vers les mains ; plus les pieds sont avancés, plus c'est dur.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Renegade row</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Position de pompe, une main sur chaque haltère, pieds écartés pour la stabilité. Tire un haltère vers la hanche sans laisser le bassin pivoter.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pullover avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé en travers d'un lit ou d'une chaise, tout le dos en appui. Un sac tenu à deux mains, bras légèrement fléchis (15-20°) et cet angle ne bouge plus. Descends jusqu'à sentir l'étirement des dorsaux, puis ramène les coudes vers les hanches — ne pousse pas avec les bras. Arrête la montée quand les bras sont au-dessus de la poitrine.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché à environ 45°, dos plat, un sac chargé dans chaque main. Tire les coudes vers les hanches.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing bûcheron avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un genou et une main en appui sur une chaise, l'autre main tient le sac. Tire le coude le long du corps, sans tourner le buste.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rowing unilatéral avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché, une main en appui, l'autre tient le sac. Tire le coude vers la hanche.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Soulevé de terre avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un sac chargé dans chaque main, le long des jambes. Dos plat, pousse dans le sol avec les jambes et termine hanches tendues.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Tirage australien</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sous une table solide ou une barre basse, corps incliné et pieds au sol. Plus les pieds sont loin, plus c'est dur.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Traction pronation (barre de fortune)</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Une barre solide suffit : dessous d'escalier, barre de but, structure fixe. Paumes vers l'avant. Débutant : pose un pied sur une chaise pour t'aider, et retire de l'aide au fil des semaines. Avancé : sac à dos chargé. Évite les huisseries de porte, elles ne sont pas prévues pour supporter un corps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Traction supination (barre de fortune)</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Même chose en prise supination, paumes vers toi — les biceps travaillent davantage. Débutant : un pied sur une chaise pour t'aider. Évite les huisseries de porte.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ ÉPAULES</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>17 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 6 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé militaire barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>178</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Debout, gainage serré, fessiers contractés. Pousse la barre à la verticale au-dessus de la tête en rentrant légèrement la tête au passage. Ne cambre pas le bas du dos.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élévations latérales câble</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>16</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poulie basse, monte le bras sur le côté jusqu'à l'horizontale. Coude légèrement fléchi, sans hausser l'épaule.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Face pull câble</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>3</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Corde à hauteur du visage. Tire vers le front en écartant les mains, coudes hauts et épaules basses.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé épaules machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé épaules machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Siège réglé pour que les poignées soient au niveau des épaules. Pousse verticalement sans cambrer, dos plaqué au dossier.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Oiseau machine (pec deck inversé)</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pec deck</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poitrine contre le dossier, bras quasi tendus. Écarte vers l'arrière en pensant à écarter les COUDES, pas les mains ; garde les épaules basses.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Shrugs barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bras tendus, barre devant les cuisses. Monte les épaules vers les oreilles à la verticale et marque un temps en haut. Les rotations d'épaules n'apportent rien.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élévations latérales haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>45</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Monte les bras sur les côtés jusqu'à l'horizontale, coudes légèrement fléchis. Charge légère — c'est un petit muscle, l'élan ne sert à rien.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Oiseau haltères (deltoïde postérieur)</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>13</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché, bras tendus vers le sol. Ouvre les bras sur les côtés sans hausser les épaules.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé militaire haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>9</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères au niveau des oreilles, pousse à la verticale. Gainage serré, pas de cambrure lombaire.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élévations frontales haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Monte les bras tendus devant toi jusqu'à hauteur des yeux, pas plus haut. Pas d'élan de hanches : si tu dois balancer, l'haltère est trop lourd.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Shrugs haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères le long du corps, bras tendus. Hausse les épaules à la verticale et marque un temps en haut ; ne plie pas les coudes pour tricher.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Tirage vertical menton barre</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Prise un peu plus large que les épaules. Monte les coudes jusqu'à hauteur d'épaules, PAS PLUS HAUT : au-delà, l'épaule se pince. Si tu sens un pincement, élargis la prise.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompes piquées</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>131</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe en position pliée, bassin haut, mains sous les épaules. Descends le sommet du crâne vers le sol — c'est la marche avant le handstand push-up.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élévations latérales avec sac ou bouteilles</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Une bouteille d'eau dans chaque main suffit — la charge utile est faible sur cet exercice. Monte les bras sur les côtés jusqu'à l'horizontale, coudes légèrement fléchis. Un sac tenu par la poignée quand les bouteilles deviennent trop légères.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Face pull avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché en avant, un sac tenu à deux mains. Tire vers le visage en gardant les coudes hauts, écarte les mains en fin de mouvement.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Handstand push-up contre un mur</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>En équilibre sur les mains, dos ou ventre au mur selon ce que tu maîtrises. Descends la tête vers le sol et repousse. À ne tenter qu'une fois l'équilibre au mur maîtrisé.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Oiseau avec sac ou bouteilles</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché, bras tendus vers le sol, une bouteille ou un sac dans chaque main. Ouvre les bras sur les côtés sans hausser les épaules.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ BICEPS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>18 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 8 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl barre EZ</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre EZ</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>166</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Coudes fixes le long du corps, monte la barre sans balancer le buste. La prise coudée de l'EZ ménage les poignets.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl incliné haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc réglable</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>17</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis sur un banc incliné, bras qui pendent en arrière du buste. C'est cet étirement de départ qui fait l'exercice — n'avance pas les coudes pour tricher.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl barre droite</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Coudes collés au corps et fixes. Monte la barre sans reculer les coudes ni balancer le buste, et contrôle la descente jusqu'aux bras tendus.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl biceps machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl biceps machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Règle le siège pour que le coude soit aligné avec l'axe de rotation. Ne décolle pas les bras du coussin et contrôle le retour.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl câble bayésien</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos à la poulie basse, bras légèrement en ARRIÈRE du corps. Cette position étire le biceps et place la tension maximale en bas : c'est tout l'intérêt de la variante.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Debout face à la poulie, coudes fixes contre le corps. Le câble garde la tension même en bas — profites-en pour contrôler la descente.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl câble poulie haute (spider)</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poulie en haut, bras tendu à l'horizontale. Amène la main vers la tête sans bouger le coude ; la tension est maximale en position contractée.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Preacher curl machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Preacher curl machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Aisselles bien calées en haut du pupitre. Ne tends pas les bras d'un coup en bas : la remontée doit rester sous contrôle, le biceps est vulnérable en position étirée.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl aux anneaux</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Anneaux de gymnaste</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>129</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Anneaux réglés bas, corps incliné en arrière, paumes vers toi. Fléchis les coudes pour amener les mains vers le front, coudes hauts et fixes.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl haltères alternés</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>22</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un bras après l'autre, coudes fixes le long du corps. Tourne progressivement la paume vers le haut en montant.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl élastique</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élastiques de résistance</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>16</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pieds sur l'élastique, coudes fixes le long du corps. La résistance augmente en fin de montée : ralentis la descente.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl marteau</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>14</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Prise neutre, pouces vers le haut, coudes fixes. Travaille aussi le brachial et l'avant-bras.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl concentré</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis, coude calé contre l'intérieur de la cuisse. Monte jusqu'à la contraction complète et descends lentement bras tendu, sans aucun mouvement d'épaule.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl Zottman</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Monte en supination paumes vers le haut, tourne les poignets en haut, redescends en pronation paumes vers le bas. La descente en pronation est le vrai travail.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Prends un sac par les poignées, paumes vers le haut (supination), et remplis-le au poids voulu. Coudes fixes le long du corps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl avec sac alterné</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un sac dans chaque main en supination, un bras après l'autre. Coudes fixes le long du corps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl incliné sur chaise avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis au bord de la chaise, haut du dos contre le dossier, bras qui pendent le long du dossier. Curl en gardant les coudes en arrière — c'est cet étirement qui fait l'exercice.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl marteau avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Prends le sac par les poignées, pouces vers le haut (prise neutre), et remplis-le au poids voulu.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ TRICEPS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>19 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 10 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dips triceps machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dips triceps machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>186</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos calé, coudes serrés le long du corps. Tends les bras sans verrouiller brutalement.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Skull crusher barre EZ</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre EZ + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>65</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé, coudes fixes pointés vers le plafond. Descends la barre vers le front : seuls les avant-bras bougent.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p>X</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Triceps poulie haute corde</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>37</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Coudes fixes le long du corps. Tends les bras vers le bas et écarte la corde en fin de mouvement.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Développé couché prise serrée</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mains à largeur d'épaules, pas plus serrées : trop serré, ce sont les poignets qui prennent. Coudes près du corps, descends vers le bas des pectoraux.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>French press barre EZ (overhead)</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre EZ + Banc réglable</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis dossier haut, barre EZ au-dessus de la tête, coudes serrés. Descends derrière la nuque jusqu'à l'étirement et remonte sans écarter les coudes.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>JM press</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>À mi-chemin entre le développé serré et le skull crusher : descends la barre vers le haut de la poitrine en laissant les coudes avancer. Charge modérée, très exigeant pour les coudes.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Skull crusher haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Coudes fixes pointés vers le plafond. Descends les haltères de part et d'autre de la tête, seuls les avant-bras bougent. Meilleure position de poignet qu'à la barre.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Triceps câble barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Coudes collés au corps, buste légèrement penché. Tends les bras complètement vers le bas et contrôle le retour sans remonter les coudes.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Triceps machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Triceps machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Règle le siège pour aligner tes coudes avec l'axe de la machine. Tends les bras complètement et contrôle le retour sans te laisser tirer par la charge.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Triceps poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos à la poulie, bras au-dessus de la tête, coudes serrés. Tends les bras vers le haut sans laisser les coudes s'écarter.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Extension triceps élastique</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élastiques de résistance</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>28</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élastique fixé en hauteur, coudes fixes le long du corps. Tends les bras vers le bas et contrôle le retour.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Extension triceps haltère bilatérale</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltère tenu à deux mains derrière la tête, coudes serrés et pointés vers le haut. Descends jusqu'à l'étirement complet du triceps sans écarter les coudes.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Extension triceps haltère unilatérale</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un bras au-dessus de la tête, coude pointé vers le plafond, l'autre main peut soutenir le coude. Descends derrière la nuque et remonte sans bouger le coude.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Kickback haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché, bras collé au corps, coude fixe et haut. Tends l'avant-bras vers l'arrière jusqu'au verrouillage et marque un temps ; charge légère obligatoire.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pompe diamant</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>55</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mains jointes en losange sous la poitrine, coudes serrés le long du corps. Ce sont les triceps qui travaillent, pas les pectoraux.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dips entre deux chaises (buste droit)</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mains sur deux chaises stables, buste droit et coudes serrés pour cibler les triceps. Pieds éloignés ou surélevés pour durcir, sac à dos chargé ensuite. Vérifie que les chaises ne peuvent pas glisser.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Extension triceps avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un sac chargé tenu à deux mains derrière la nuque, coudes hauts et fixes. Tends les bras vers le haut.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Kickback triceps avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste penché en avant, coude fixé le long du corps, bras replié. Tends l'avant-bras vers l'arrière jusqu'à verrouiller le coude et marque un temps — c'est en fin de course que le triceps travaille le plus sur ce mouvement. Un sac par la poignée dans chaque main, ou une main après l'autre en appui sur une chaise.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Skull crusher avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé au bord d'un lit ou d'une chaise, sac chargé tenu à deux mains. Coudes fixes, descends le sac vers le front.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ ABDOMINAUX</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>19 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 6 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Crunch câble</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>131</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>À genoux face à la poulie haute, corde derrière la nuque. Enroule le buste vers les cuisses en gardant les hanches fixes — ce sont les abdos qui tirent, pas les bras.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Crunch machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Crunch abdos machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>63</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos bien calé, poignées au niveau des épaules. Enroule le buste et contrôle le retour sans laisser la charge te tirer.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Captain chair relevés genoux</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Captain chair</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Avant-bras calés, dos plaqué. Monte les genoux en ENROULANT le bassin vers le haut — si tu montes seulement les cuisses, ce sont les fléchisseurs de hanche qui travaillent, pas les abdos.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dragon flag</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Accroche-toi derrière la tête, corps gainé d'un seul bloc. Descends le corps entier lentement en gardant la ligne épaules-hanches-pieds. Très difficile : commence genoux pliés.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pallof press câble</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie haute</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>De profil à la poulie, mains devant le sternum. Tends les bras en résistant à la rotation — le but est de NE PAS bouger. Gaine et respire.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rotation obliques machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Rotation obliques machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bassin bloqué, la rotation vient du buste. Va progressivement et sans à-coups : le bas du dos n'aime pas la rotation chargée et rapide.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Relevés de jambes suspendu</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre de traction</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>175</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Suspendu à la barre, monte les jambes tendues sans balancer. Enroule le bassin en fin de montée : c'est là que les abdos travaillent vraiment.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>L-sit</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barres parallèles</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>66</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Aux barres parallèles, bras tendus, épaules basses. Décolle le bassin et tends les jambes à l'horizontale, puis tiens la position.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Roulette abdominale</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Roulette abdominale</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>42</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>À genoux, déroule la roulette vers l'avant en gardant le bas du dos plat. Ne va que jusqu'où tu peux revenir sans creuser.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Crunch Swiss ball</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Swiss ball</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bas du dos sur le ballon, pieds bien stables. Descends légèrement en arrière pour étirer les abdos, puis enroule le buste : c'est cette amplitude en extension qui fait l'intérêt du ballon.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Planche</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>54</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Appui sur les avant-bras et les pointes de pieds, corps aligné des talons à la tête. Serre les fessiers et rentre le bassin — pas de dos creux.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Crunch au sol</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>36</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé sur le dos, genoux fléchis. Décolle les omoplates en enroulant le buste, sans tirer sur la nuque. Inter./avancé : tiens un sac chargé contre la poitrine ou bras tendus derrière la tête.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dead bug</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé, bas du dos plaqué au sol. Descends un bras et la jambe opposée sans jamais laisser le dos se creuser ; si le dos décolle, réduis l'amplitude.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Gainage latéral</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sur le côté, coude sous l'épaule. Monte le bassin jusqu'à l'alignement pieds-hanches-épaules et tiens la position sans laisser les hanches redescendre.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hollow body hold</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Bas du dos plaqué au sol, épaules et jambes décollées. Cherche la position où le dos reste collé : si tu sens un creux lombaire, remonte les jambes.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>L-sit au sol</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis au sol, mains à plat de chaque côté des hanches, décolle le bassin et tends les jambes à l'horizontale. Garde la position.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mountain climbers</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Position de pompe, bassin stable. Ramène les genoux vers la poitrine en alternant, sans laisser les hanches monter ni s'affaisser.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Relevés de jambes au sol</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé sur le dos, mains sous les fesses, monte les jambes tendues sans décoller le bas du dos. Trop facile ? Serre un sac chargé entre les pieds.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Russian twist</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Medicine ball</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Buste incliné en arrière, pieds décollés ou au sol. Fais tourner les ÉPAULES d'un côté à l'autre, pas seulement les bras, et va lentement.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ QUADRICEPS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>28 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 11 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg extension</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg extension</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>146</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos calé, axe de rotation de la machine aligné sur le genou. Tends complètement et contrôle la descente.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Rack squat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>109</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre sur le haut du dos, descends au moins jusqu'aux cuisses parallèles. Genoux dans l'axe des pieds, dos plat, regard neutre.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Front squat barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Rack squat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>85</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre sur les deltoïdes avant, coudes hauts. Le buste reste droit — c'est ce qui cible les quadriceps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fente bulgare haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc réglable</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>76</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pied arrière sur un banc, descends sur la jambe avant. Buste légèrement penché pour plus de fessiers, droit pour plus de quadriceps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg press</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg press</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>38</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pieds au milieu du plateau, descends jusqu'à environ 90° sans décoller le bassin. Ne verrouille pas les genoux en haut.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hack squat machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hack squat machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>16</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos calé, pieds au milieu du plateau. Descends au moins jusqu'aux cuisses parallèles.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Belt squat</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Belt squat machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Ceinture sur les hanches, la charge tire vers le bas sans passer par le dos. Descends bas en gardant le buste droit — l'intérêt de la machine est justement d'épargner les lombaires.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fente avant barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre sur les trapèzes, un grand pas en avant. Le genou arrière descend vers le sol, buste droit, genou avant au-dessus du pied. Ne va pas à l'échec : l'équilibre lâche avant le muscle.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Soulevé de terre trap bar</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Trap bar</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Debout au centre de la trap bar, poignées sur les côtés. Dos plat, pousse le sol avec les jambes. Plus tolérant pour les lombaires que la barre droite, mais ne va pas à l'échec.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat Smith</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Smith machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pieds légèrement avancés par rapport à la barre : la barre étant guidée, c'est la position des pieds qui fixe la trajectoire. Vérifie les crochets avant de charger.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Step-up haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pose tout le pied sur le banc et pousse sur le TALON du pied posé, sans t'aider d'un élan de la jambe restée au sol. Redescends en contrôlant, ne saute pas.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fente marchée haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>15</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Avance en fentes en alternant les jambes, genou arrière proche du sol. Grand pas = fessiers, petit pas = quadriceps.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Box jump</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Boîte pliométrique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Saute et réceptionne en amorti, pieds à plat sur la boîte. REDESCENDS EN MARCHANT — ne saute pas depuis la boîte, c'est là que le tendon d'Achille lâche.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fente avant haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères le long du corps, grand pas en avant. Le genou arrière descend vers le sol, le buste reste vertical. Pousse sur le talon avant pour revenir.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat gobelet</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Kettlebells</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Kettlebell tenue contre la poitrine, coudes rentrés. Le poids devant sert de contrepoids : il t'aide à garder le buste droit et à descendre bas.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères le long du corps, pieds largeur d'épaules. Descends en poussant les hanches vers l'arrière, dos droit, jusqu'à ce que les cuisses soient au moins parallèles au sol.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Thruster haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères sur les épaules, squat complet, puis la remontée enchaîne directement sur le développé — un seul mouvement fluide. Ne va pas à l'échec avec une charge au-dessus de la tête.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sissy squat</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>113</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Genoux vers l'avant, buste et cuisses alignés, descends en arrière. Amplitude progressive : c'est exigeant pour les genoux.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pistol squat</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>55</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat sur une jambe, l'autre tendue devant. Tends les bras devant toi pour l'équilibre, contrôle la descente.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat au poids du corps</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>13</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pieds largeur d'épaules, descends au moins jusqu'aux cuisses parallèles. Dos plat, genoux dans l'axe des pieds.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Burpees</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Enchaîne squat, mains au sol, jambes en arrière, pompe, retour des jambes, saut. Garde le dos gainé au moment de la pompe : c'est la fatigue qui fait creuser les lombaires.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fente bulgare (chaise)</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pied arrière posé sur une chaise, descends sur la jambe avant. Sac à dos chargé, ou un sac dans chaque main, pour ajouter du poids.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fente marchée avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sac à dos chargé, avance en fentes en alternant les jambes. Genou arrière proche du sol sans le toucher.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fentes alternées</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Grand pas en avant, genou arrière vers le sol, buste vertical. Pousse sur le talon avant pour revenir, puis alterne. Le genou avant reste au-dessus du pied.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Front squat avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un sac chargé tenu contre la poitrine, coudes hauts. Descends en gardant le buste droit.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg extension assis avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis sur une chaise, un sac chargé accroché aux pieds ou posé sur les chevilles. Tends les jambes, contrôle la descente.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc A</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sac à dos chargé sur le dos, ou tenu contre la poitrine. Descends au moins jusqu'aux cuisses parallèles, dos plat.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Wall sit</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos plaqué au mur, cuisses parallèles au sol, genoux à 90° à l'aplomb des chevilles. Tiens la position sans poser les mains sur les cuisses.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ ISCHIO-JAMBIERS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>10 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 4 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Soulevé de terre roumain barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>77</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Jambes quasi tendues, pousse les hanches vers l'arrière en gardant la barre proche des jambes. Descends jusqu'à l'étirement des ischios, pas plus bas.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg curl assis</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg curl assis</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>63</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos calé, ramène les talons sous le siège et contrôle le retour sans relâcher d'un coup.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Good morning</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>53</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre sur le haut du dos, genoux légèrement fléchis, dos plat. Pousse les hanches vers l'arrière jusqu'à l'étirement des ischios. Charge modérée, c'est un exercice technique.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p><text:span text:style-name="Gras">Ne pas aller à l'échec</text:span> — lift technique</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg curl allongé</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg curl allongé</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>26</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>À plat ventre, ramène les talons vers les fessiers sans décoller les hanches du support.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Kettlebell swing</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Kettlebells</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>C'est une charnière de HANCHE, pas un squat : les hanches reculent, la kettlebell passe entre les jambes. La projection vient du coup de hanches, les bras ne font que suivre.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Soulevé de terre roumain haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Jambes quasi tendues, genoux à peine fléchis. Pousse les hanches vers l'arrière et descends les haltères le long des jambes jusqu'à l'étirement des ischios, dos plat.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Nordic curl</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>GHD</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>129</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>À genoux, chevilles bloquées. Descends le buste vers l'avant en résistant le plus longtemps possible, puis rattrape-toi sur les mains.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Good morning avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un sac chargé sur le haut du dos, dos plat, genoux légèrement fléchis. Pousse les hanches vers l'arrière jusqu'à sentir l'étirement des ischios, puis reviens.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg curl au sol avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>À plat ventre, serre un sac chargé entre les pieds et ramène les talons vers les fesses.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Soulevé de terre roumain avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Un sac chargé dans chaque main. Jambes quasi tendues, pousse les hanches vers l'arrière en gardant le dos plat. Descends jusqu'à l'étirement des ischios, pas plus bas.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ FESSIERS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>7 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 5 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hip thrust barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>216</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haut du dos contre le banc, barre sur les hanches avec un coussin. Monte jusqu'à l'alignement genoux-hanches-épaules, menton rentré, et serre en haut.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hip thrust machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hip thrust machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>71</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Dos calé, pousse le coussin par les hanches. Marque un temps d'arrêt en haut en serrant les fessiers.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fessier machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Fessier machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Cale bien le buste et le bassin. Pousse jusqu'à l'extension complète de la hanche, sans cambrer le bas du dos pour aller plus loin.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Hip thrust haltères</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères + Banc plat</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haut du dos calé sur le banc, haltère sur le bassin. Monte les hanches jusqu'à l'alignement épaules-hanches-genoux, menton rentré, et serre les fessiers en haut.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Kickback fessier câble</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Câble poulie basse</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sangle à la cheville, buste légèrement penché en appui. Envoie la jambe vers l'arrière en gardant le dos immobile ; ne cambre pas pour gagner de l'amplitude.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pont fessier au sol</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>30</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé sur le dos, pieds au sol près des fessiers. Monte le bassin en serrant les fessiers, sans creuser le bas du dos en haut.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pont fessier avec sac ou unilatéral</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé sur le dos, pieds au sol, monte le bassin en serrant les fessiers. Pose un sac chargé sur les hanches, ou fais-le sur une seule jambe pour durcir.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ MOLLETS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>10 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 4 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets debout machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets debout machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>124</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Jambes tendues, amplitude complète, temps de pause en haut de chaque répétition.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets assis machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets assis machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>81</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Genoux fléchis à 90°, monte le plus haut possible et descends en étirement complet. Genou fléchi = c'est le soléaire qui travaille.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets leg press</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Leg press</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>58</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Avant-pieds sur le bas du plateau. Pousse par les orteils sans déverrouiller les genoux.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets debout barre</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre olympique</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre sur les trapèzes, avant-pieds sur une cale si tu en as une. Monte le plus haut possible sur les pointes, marque un temps, et descends jusqu'à l'étirement complet.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets lestés une jambe</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Gilet lesté</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>96</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sur une jambe, avant-pied sur une marche, gilet ou ceinture de lest. Amplitude complète, contrôle la descente.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Corde à sauter</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Corde à sauter</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sauts bas et rapides sur l'avant du pied, genoux souples. La corde est tournée par les POIGNETS, pas par les épaules.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets debout haltères</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères le long du corps. Monte sur les pointes au maximum, temps d'arrêt en haut, descente lente jusqu'à l'étirement : c'est l'amplitude complète qui fait le travail.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets unilatéraux poids du corps</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>110</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sur une jambe, avant-pied sur une marche. Monte le plus haut possible et contrôle la descente jusqu'à l'étirement.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets assis avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis sur une chaise, genoux fléchis à 90°, un sac chargé posé sur les cuisses juste au-dessus des genoux. Monte les talons le plus haut possible, descends en étirement complet. Genou fléchi = c'est le soléaire qui travaille, pas les jumeaux.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mollets unilatéraux avec sac</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Sur une jambe, avant-pied sur une marche, monte le plus haut possible et contrôle la descente. Sac à dos chargé pour durcir.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ AVANT-BRAS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>3 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 1 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Curl inversé barre EZ</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre EZ</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Prise en pronation, paumes vers le bas, coudes fixes. La charge est nettement plus légère qu'au curl classique, c'est normal : le levier est défavorable.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Marche du fermier</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères le long du corps, épaules basses et en arrière, buste droit. Marche à pas réguliers en gainant ; le poids ne doit pas te faire pencher d'un côté.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Wrist curl barre EZ</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Barre EZ</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Avant-bras posés sur les cuisses ou un banc, poignets dans le vide. Laisse la barre dérouler jusqu'au bout des doigts puis enroule. Amplitude complète, charge légère.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ ABDUCTEURS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>3 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 1 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Abducteur machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Abducteur machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>36</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Assis, dos calé, écarte les genoux contre la résistance et contrôle le retour. Ne t'aide pas avec le buste.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Abduction mini-bands</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Mini-bands</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Élastique au-dessus des genoux. Écarte les genoux contre la résistance sans bouger le bassin ; le mouvement est court, la tension reste continue.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Abduction de hanche allongé sur le côté</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Allongé sur le côté, monte la jambe du dessus tendue, contrôle la descente. Trop facile ? Pose un sac chargé sur la cuisse.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Exercice de <text:span text:style-name="Gras">repli</text:span> (improvisé) : montre bien le montage</text:p><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>▼ ADDUCTEURS</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>3 exercice(s)</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p>dont 1 en salle</text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Titre" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Adducteur machine</text:p></table:table-cell><table:table-cell table:style-name="Salle" office:value-type="string"><text:p>SALLE</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Adducteur machine</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Règle l'écartement de départ sans forcer l'étirement. Serre les cuisses jusqu'à la fermeture et contrôle le retour, sans laisser les jambes s'écarter brutalement.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Squat sumo</text:p></table:table-cell><table:table-cell table:style-name="Leger" office:value-type="string"><text:p>Matériel léger</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Haltères</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>polyarticulaire · bloc B</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Pieds bien plus larges que les épaules, pointes vers l'extérieur. Descends entre les jambes, genoux dans l'axe des pieds ; tu dois sentir l'intérieur des cuisses.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Case" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Copenhagen plank</text:p></table:table-cell><table:table-cell table:style-name="Partout" office:value-type="string"><text:p>Partout</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>aucun</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>0</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>isolation · bloc C</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>En gainage latéral, jambe du dessus posée sur un support. Monte le bassin en poussant sur l'intérieur de la cuisse posée. Commence genou plié, c'est très intense pour les adducteurs.</text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p>Poids du corps : montre aussi la <text:span text:style-name="Gras">version facile et la version dure</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="Corps" office:value-type="string"><text:p></text:p></table:table-cell></table:table-row>
</table:table>
</office:spreadsheet></office:body></office:document>